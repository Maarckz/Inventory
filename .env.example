###########################################
## CONFIGURAÇÕES DE SEGURANÇA E AMBIENTE ##
###########################################
SECRET_KEY=SUA_SECRET_KEY_AQUI
SESSION_SALT=SEU_HASH_SALT
LOG_DIR=logs

###########################
## CONFIGURAÇÕES DE REDE ##
###########################
HOST=0.0.0.0
PORT=8000
DEBUG=False

############################
## CONFIGURAÇÕES DE HTTPS ##
############################
USE_HTTPS=True
SSL_CERT_PATH=ssl/cert.pem
SSL_KEY_PATH=ssl/key.pem

######################################
## PERMITIR IPS DE FAIXA ESPECIFICA ##
######################################
ALLOWED_IP_RANGES=0.0.0.0/0

#######################################
## USA PROXY REVERSO? (0=NAO, 1=SIM) ##
#######################################
TRUST_PROXY=0

#############################
## API DO WAZUH (MANAGER)  ##
#############################
WAZUH_PROTOCOL=https
WAZUH_HOST=IP_WAZUH
WAZUH_PORT=55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=SENHA_WAZUH

###############################
## BANCO DE DADOS POSTGRESQL ##
###############################
# OS DADOS DEVEM ESTAR NO DOCKER COMPOSE TAMBEM
DB_USER=inventorydb
DB_PASS=senhadoinventorydb 
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db

###################
##  CACHE REDIS  ##
###################
REDIS_URL=redis://localhost:6379/0
#REDIS_TTL_MACHINES=3600
#REDIS_TTL_STATS=40

########################################
## ADMIN INICIAL (só com banco vazio) ##
########################################
ADMIN_PASSWORD=Meuadmin123
# true  = obriga trocar a senha no 1º login
# false = entra direto com a senha acima
# vazio = força troca apenas quando a senha foi gerada automaticamente
ADMIN_MUST_CHANGE_PASSWORD=false

#################################################
## GATEWAY DE API — rotas de API não expostas  ##
#################################################
API_LOCK=1

############################
## ASSISTENTE IA — GROQ   ##
############################
GROQ_API_KEY=API_KEY_GROQ
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# MODELOS: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
# Endpoint alternativo
GROQ_BASE_URL=https://api.groq.com/openai/v1
# BACKOFF — MITIGAÇÃO DE RATE LIMIT 
